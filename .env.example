# ===== MiniMax LLM（OpenAI 兼容接口）=====
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
# 非推理模型，首字延迟最低（实测 ~2s），适合实时语音对话。
# 注意：M2.x/M3 等推理模型在 OpenAI 兼容端点上无法真正关闭思考，首字要等 6~10s，勿用于实时语音。
MINIMAX_MODEL=MiniMax-Text-01

# ===== MiniMax TTS（T2A v2）=====
MINIMAX_TTS_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-02-turbo
MINIMAX_VOICE_ID=female-shaonv
# 翻译模式（translate.py）朗读英文用的音色，留空则回退到上面的中文音色
MINIMAX_VOICE_ID_EN=
# 翻译模式朗读日文用的音色，留空则回退默认音色
MINIMAX_VOICE_ID_JA=Japanese_KindLady
# 翻译模式默认目标语言：en（中译英）/ ja（中译日）；运行时输入 en/ja 可随时切换
TARGET_LANG=en

# ===== STT 后端 =====
# local=本地 faster-whisper（离线免费，无需 key）
# aliyun=阿里云百炼 Paraformer 实时 ASR（中文、低延迟、国内直连，需 DASHSCOPE_API_KEY）
STT_BACKEND=local

# ===== 云 STT（阿里云百炼 Paraformer，STT_BACKEND=aliyun 时启用）=====
# 在阿里云百炼控制台申请，北京 region key；SDK 默认走国内 dashscope.aliyuncs.com
DASHSCOPE_API_KEY=
PARAFORMER_MODEL=paraformer-realtime-v2

# ===== 本地 STT（faster-whisper，离线，无需 key；STT_BACKEND=local 时使用）=====
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=zh
