# ===== MiniMax LLM（OpenAI 兼容接口）=====
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01

# ===== MiniMax TTS（T2A v2）=====
MINIMAX_TTS_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-02-turbo
MINIMAX_VOICE_ID=female-shaonv

# ===== 本地 STT（faster-whisper，离线，无需 key）=====
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=zh
